{
  "name": "epm-payroll-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Employee Payroll Management System",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:generate": "npm run db:generate -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
